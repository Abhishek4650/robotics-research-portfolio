Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Plane: XY
      Cell Size: 0.05
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.1
      Show Names: true
    - Class: rviz_default_plugins/Path
      Name: TargetSine
      Enabled: true
      Topic:
        Value: /target_sine_path
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 200; 25
      Line Style: Lines
      Line Width: 0.005
    - Class: rviz_default_plugins/Path
      Name: DrawnPath
      Enabled: true
      Topic:
        Value: /drawn_path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 220; 30; 30
      Line Style: Billboards
      Line Width: 0.006
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.9
      Focal Point:
        X: 0.1
        Y: 0.0
        Z: 0.2
      Pitch: 0.35
      Yaw: 5.6
Window Geometry:
  Height: 800
  Width: 1200
