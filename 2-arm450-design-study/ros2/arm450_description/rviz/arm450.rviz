Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.1
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.08
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SinePath
      Topic:
        Value: /sine_path
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.78
      Focal Point: {X: 0.16, Y: 0, Z: 0.24}
      Pitch: 0.42
      Yaw: 1.15
# Without this block RViz opens at its built-in default, which on this machine
# is 728 x 604 -- and the Displays panel eats half of that, leaving a 3D view
# too small to see a 45 mm gripper on a 450 mm arm.
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  X: 60
  Y: 60
